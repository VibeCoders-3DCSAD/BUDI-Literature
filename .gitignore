# Python
__pycache__/
*.pyc
.venv/

# Corpus markdown and sidecar — committed (conversions live flat in literature/mds/)
!literature/mds/
!literature/mds/**/

# PDFs — fetched, not committed (use scripts/fetch_pdfs.py)
literature/pdfs/
*.pdf

# Intake bucket — staged downloads, triaged into literature/pdfs/
bucket/

# Derived heavy artifacts (regenerable, if a stage ever needs them)
cache/

# Raw binary exports — ignored so a stray spreadsheet is never committed
*.csv
*.xlsx
*.zip

# ...except the generated review tables, which are deliverables
!review/data/*.csv

# Local scratch
*.log
.DS_Store
